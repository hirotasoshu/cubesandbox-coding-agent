# CubeAPI access used by the E2B-compatible SDK.
E2B_API_URL=https://api.sandbox.example.com
E2B_API_KEY=<cube-api-key>
E2B_VALIDATE_API_KEY=false
CUBE_TEMPLATE_ID=<template-id>

# Custom OpenAI-compatible Responses API used by Codex and OpenCode.
# Omit OPENAI_BASE_URL to use the native OpenAI provider with the API key.
OPENAI_BASE_URL=https://llm.example.com/v1
OPENAI_API_KEY=<model-provider-key>
CODEX_MODEL=<model-id>
OPENCODE_MODEL=openai_compatible/<model-id>

# Native CubeSandbox SDK access used only by policy examples.
CUBE_API_URL=https://api.sandbox.example.com
CUBE_API_KEY=<cube-api-key>
CUBE_PUBLIC_SCHEME=https

# Optional local destination for downloaded workspace archives.
WORKSPACE_OUTPUT_DIR=workspace-output
